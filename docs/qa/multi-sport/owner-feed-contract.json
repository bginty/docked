        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "url",
          "sha256"
        ],
        "additionalProperties": false
      },
      "players": {
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "providerPlayerId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9:._-]{1,120}$"
            },
            "availability": {
              "type": "string",
              "enum": [
                "complete",
                "pending",
                "confirmed-dnp"
              ]
            },
            "stats": {}
          },
          "required": [
            "providerPlayerId",
            "availability",
            "stats"
          ],
          "additionalProperties": false
        }
      }
