  "framework": "nextjs",
  "regions": ["syd1"],
  "crons": [
    { "path": "/api/store/google/scheduled", "schedule": "*/5 * * * *" }
  ],
  "buildCommand": "node scripts/guard-hosted-build.mjs && npm run build",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": {
      "codex/vercel-beta-review": false,
      "codex/v31-founder-acceptance-20261111": false,
      "codex/v31-phone-privacy-candidate-20261112": false
    }
  }
}
