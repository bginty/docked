<section class="docked-section color-{{ section.settings.color_scheme }} gradient" aria-labelledby="FAQ-{{ section.id }}">
  <div class="docked-section__inner docked-faq">
    <div>
      <p class="docked-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 id="FAQ-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="rte docked-lede">{{ section.settings.text }}</div>
      {%- if section.settings.link_label != blank -%}<a class="docked-text-link" href="{{ section.settings.link | default: '/pages/faq' }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
    </div>
    <div class="docked-faq__items">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          <details class="docked-faq__item" {{ block.shopify_attributes }}>
            <summary><span>{{ block.settings.question | escape }}</span>{{- 'icon-caret.svg' | inline_asset_content -}}</summary>
            <div class="rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{%- liquid
  assign faq_schema_count = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign faq_schema_count = faq_schema_count | plus: 1
    endif
  endfor
-%}
{%- if faq_schema_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_schema_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- assign faq_schema_index = faq_schema_index | plus: 1 -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
              }
            }{%- unless faq_schema_index == faq_schema_count -%},{%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .docked-faq { display: grid; gap: 3rem; align-items: start; }
  .docked-faq__items { border-top: .1rem solid rgba(6,40,61,.18); }
  .docked-faq__item { border-bottom: .1rem solid rgba(6,40,61,.18); }
  .docked-faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 2rem 0; color: #06283d; cursor: pointer; font-size: 1.7rem; font-weight: 800; }
  .docked-faq__item summary svg { width: 1.4rem; transition: transform .2s ease; }
  .docked-faq__item[open] summary svg { transform: rotate(180deg); }
  .docked-faq__item .rte { padding: 0 0 2rem; }
  @media screen and (min-width: 990px) { .docked-faq { grid-template-columns: .8fr 1.2fr; gap: 7rem; } }
  @media (prefers-reduced-motion: reduce) { .docked-faq__item summary svg { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Docked FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you get in." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Clear answers on adult-only use, safety, product verification and launch status.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read all FAQs" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-2" }
  ],
  "blocks": [{ "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question", "default": "When will the Docked lounger be available?" },
    { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>The lounger remains Draft until the exact product, safety, compliance, pricing, imagery, shipping and payment checks are complete.</p>" }
  ] }],
  "max_blocks": 8,
  "presets": [{ "name": "Docked FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
