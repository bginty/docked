# Local preview is the default. Never reuse production credentials in previews.
APP_ENV=preview
# Exact reviewed Git HEAD for a locally run build/worker; keep empty until verified.
# Vercel deployments require platform-provided VERCEL_GIT_COMMIT_SHA instead.
DOCKED_CODE_COMMIT=
SITE_URL=http://localhost:3000
SUPABASE_ENV=preview
# Optional hosted acceptance exception; leave empty by default. Requires verified
# project bckkllmndoxzpzdqrevb, loopback site, same-project DB, unexpired capture
# proof and an exact reserved test recipient in preview_auth (never a wildcard).
PREVIEW_AUTH_CAPTURE_MODE=
PREVIEW_AUTH_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Remote DB connections always verify server certificates. Supply an absolute path
# to a reviewed public root CA when the provider is not trusted by Node's defaults.
# Hosted Docked Preview uses certs/supabase-prod-ca-2021.crt at its absolute host path.
DATABASE_SSL_CA_FILE=
# Polling holds a session lock: direct or session pooling is mandatory.
DATABASE_CONNECTION_MODE=direct
DEMO_MODE=false
REGISTRATION_ENABLED=false
PUBLICATION_ENABLED=false
FORWARD_PAPER_ENABLED=false
SENDING_ENABLED=false
ADS_ENABLED=false
AFFILIATES_ENABLED=false
PAID_PLANS_ENABLED=false
PRO_ENTITLEMENTS_ENABLED=false
COMPETITIONS_ENABLED=false
PRIZES_ENABLED=false
DEALS_ENABLED=false
ODDS_API_KEY=
ODDS_POLLING_ENABLED=false
ODDS_REGIONS=au
ODDS_RIGHTS_REFERENCE=
ODDS_MONTHLY_CREDIT_LIMIT=0
# Server-only, versioned and currently UNVALIDATED market-reference methodology.
# Empty means NOT_CONFIGURED. Never expose this configuration as NEXT_PUBLIC.
MARKET_REFERENCE_CONFIG_JSON=
RESULTS_RIGHTS_REFERENCE=
RESULTS_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_IDENTITY=
EMAIL_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
LEGAL_ENTITY_VERIFIED=false
# Public launch date belongs in the audited database, never in deployment env.
