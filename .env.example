# Local preview is the default. Never reuse production credentials in previews.
APP_ENV=preview
# Exact reviewed Git HEAD for a locally run build/worker; keep empty until verified.
# Vercel deployments require platform-provided VERCEL_GIT_COMMIT_SHA instead.
DOCKED_CODE_COMMIT=
SITE_URL=http://localhost:3000
SUPABASE_ENV=preview
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Polling holds a session lock: direct or session pooling is mandatory.
DATABASE_CONNECTION_MODE=direct
DEMO_MODE=false
REGISTRATION_ENABLED=false
PUBLICATION_ENABLED=false
FORWARD_PAPER_ENABLED=false
SENDING_ENABLED=false
ADS_ENABLED=false
AFFILIATES_ENABLED=false
PAID_PLANS_ENABLED=false
ODDS_API_KEY=
ODDS_POLLING_ENABLED=false
ODDS_REGIONS=au
ODDS_RIGHTS_REFERENCE=
ODDS_MONTHLY_CREDIT_LIMIT=0
RESULTS_RIGHTS_REFERENCE=
RESULTS_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_IDENTITY=
EMAIL_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
LEGAL_ENTITY_VERIFIED=false
# Public launch date belongs in the audited database, never in deployment env.
