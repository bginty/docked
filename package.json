{
  "name": "docked-value-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent sports-pricing research and immutable publication ledger",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "images:build": "node scripts/build-sport-images.mjs",
    "start": "node scripts/start-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/platform/*.test.ts",
    "test:browser": "playwright test",
    "research": "tsx scripts/research.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "db:test": "tsx --test tests/database/*.test.ts",
    "validate": "npm run typecheck && npm test && npm run db:test",
    "lint": "eslint src scripts tests --max-warnings=0",
    "check:client": "tsx scripts/check-client-boundary.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "decimal.js": "10.6.0",
    "luxon": "3.7.2",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "svix": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.27.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
