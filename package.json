{
  "name": "docked-value-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Transparent sports-pricing research and immutable publication ledger",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "images:build": "node scripts/build-sport-images.mjs",
    "start": "node scripts/start-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/platform/*.test.ts",
    "test:browser": "playwright test",
    "research": "tsx scripts/research.ts",
    "research:source-check": "tsx scripts/research-source-check.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "db:test": "tsx --test tests/database/*.test.ts",
    "validate": "npm run typecheck && npm test && npm run db:test",
    "lint": "eslint src scripts tests --max-warnings=0",
    "check:client": "tsx scripts/check-client-boundary.ts",
    "android:sync": "node scripts/build-mobile-shell.mjs && cap sync android",
    "android:open": "cap open android",
    "android:debug": "node scripts/android-debug.mjs",
    "android:preview": "node scripts/android-debug.mjs --attach-local",
    "android:inspect": "node scripts/android-debug.mjs --attach-local --inspect-webview",
    "android:hosted-preview": "node scripts/android-debug.mjs --hosted-preview",
    "android:closed-test:check": "node scripts/android-closed-test-config.mjs",
    "android:closed-test": "node scripts/android-debug.mjs --closed-test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/camera": "8.2.5",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "decimal.js": "10.6.0",
    "luxon": "3.7.2",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "svix": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.2",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.27.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
