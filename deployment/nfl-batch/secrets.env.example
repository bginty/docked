# Names only. Load privately; never commit values, print them, or pass them as CLI args.
# LOCAL exporter / future private job AND isolated Preview only:
NFL_BATCH_KEY=
# LOCAL outbound sender only; scoped to protected Preview:
VERCEL_AUTOMATION_BYPASS_SECRET=
# ISOLATED PREVIEW ONLY. Remains false until target/access acceptance:
NFL_BATCH_IMPORT_ENABLED=false
# Separate restricted writer, not production DATABASE_URL or a service-role key:
NFL_BATCH_WRITER_DATABASE_URL=
# Existing report uses a DIFFERENT read-only credential:
DOCKED_NFL_TEST_DATABASE_URL=
